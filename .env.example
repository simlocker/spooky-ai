# Prompt Security Config Variables (Prompt Security App ID is mandatory for the app to work)
# Remember to change your Gateway URL if needed

DEMO_USER_EMAIL=user@example.com
PS_APP_ID=your_prompt_security_app_id_here
PS_GATEWAY_URL=https://******.prompt.security
SHOW_CUSTOM_NOTICES=false

# Optional: force a specific named Policy from Homegrown Apps > Policies > "Manage Policies".
# Leave blank to fall back to whatever the console has marked as this connector's
# "Default Homegrown App Policy". Set explicitly here to avoid the app silently
# using a different policy than the one you're testing in the Playground.
PS_POLICY_NAME=Spooky AI policy

# LLM Keys (at least ONE required)
# Gemini, Groq, Cohere and OpenRouter use the direct API integration method.
# OpenAI is using the AI Gateway (Reverse Proxy) method.

# --- Direct API integrations ---
GEMINI_FREE_API_KEY=your_google_gemini_key_here
GROQ_API_KEY=your_groq_key_here
COHERE_API_KEY=your_cohere_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- AI Gateway (Reverse Proxy) integration ---
# OpenAI: key at https://platform.openai.com/api-keys — routed through PS Gateway
OPENAI_API_KEY=your_openai_key_here

# --- App defaults ---
# Which integration to load on startup. Must match one of the options exactly.
# Options: API (Gemini) | API (Groq) | API (Cohere) | API (OpenRouter) | AI Gateway (OpenAI) | AI Gateway (Gemini)
DEFAULT_INTEGRATION="API (Groq)"

# --- Optional Gemini model overrides ---
# DEFAULT_GEMINI_MODEL=gemini-2.0-flash
# FALLBACK_GEMINI_MODELS=gemini-1.5-pro,gemini-1.5-flash
# AUTO_SELECT_GEMINI_MODEL=true
